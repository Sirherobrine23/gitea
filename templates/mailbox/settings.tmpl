{{template "base/head" .}}
<div role="main" class="page-content user mail-box">
	<div class="ui container">
		<div class="ui stackable grid">
			<div class="four wide column">{{template "mailbox/sidebar" .}}</div>
			<div class="twelve wide column">
				<h2 class="ui header">Mail settings</h2>
				<div class="ui segment">
					<h3 class="ui header">Mailbox address</h3>
					<p><code>{{.MailboxAddress}}</code></p>
					<p class="muted">Use your Gitea username and password for authenticated SMTP submission and IMAP.</p>
				</div>
				<div class="ui segment">
					<h3 class="ui header">Folders</h3>
					<form class="ui form tw-mb-4" method="post" action="{{AppSubUrl}}/mail/settings/folders">
						<div class="inline fields">
							<div class="field"><input name="name" required maxlength="255" placeholder="Projects/Gitea"></div>
							<div class="field"><button class="ui primary button" type="submit">Create folder</button></div>
						</div>
					</form>
					<div class="ui divided list">
					{{range .MailboxCustomFolders}}
						<div class="item tw-flex tw-items-center">
							<div class="content tw-flex-1">{{.Name}}</div>
							<form method="post" action="{{AppSubUrl}}/mail/settings/folders/delete">
								<input type="hidden" name="name" value="{{.Name}}">
								<button class="ui basic red mini button" type="submit">Delete</button>
							</form>
						</div>
					{{else}}
						<div class="item muted">No custom folders configured.</div>
					{{end}}
					</div>
				</div>
				<div class="ui segment">
					<h3 class="ui header">Aliases</h3>
					<form class="ui form tw-mb-4" method="post" action="{{AppSubUrl}}/mail/settings/aliases">
						<div class="inline fields">
							<div class="field"><div class="ui right labeled input"><input name="local_part" required placeholder="alias"><div class="ui basic label">@{{.MailboxDomain}}</div></div></div>
							<div class="field"><button class="ui primary button" type="submit">Add alias</button></div>
						</div>
					</form>
					<div class="ui divided list">
					{{range .MailboxAliases}}
						<div class="item tw-flex tw-items-center">
							<div class="content tw-flex-1"><code>{{.LocalPart}}@{{$.MailboxDomain}}</code></div>
							<form method="post" action="{{AppSubUrl}}/mail/settings/aliases/{{.ID}}/delete"><button class="ui basic red mini button" type="submit">Delete</button></form>
						</div>
					{{else}}
						<div class="item muted">No aliases configured.</div>
					{{end}}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
